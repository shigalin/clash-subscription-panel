server {
    listen 443 ssl;
    server_name @@DOMAIN@@;

    ssl_certificate @@CERT_FILE@@;
    ssl_certificate_key @@KEY_FILE@@;
    ssl_protocols TLSv1.2 TLSv1.3;
    access_log off;
    error_log /dev/null crit;
    open_file_cache off;
    etag off;

    location ~ "^/(?<token>[A-Za-z0-9._~-]{32,255})/(?<folder>[A-Za-z0-9_+-][A-Za-z0-9_.+-]{0,199}[.]yaml)$" {
        set $usage_token $token;
        set $usage_folder $folder;
        set $usage_method $request_method;
        mirror /_clash_request;
        mirror_request_body off;
        alias @@DATA_DIR@@/current/live/$folder/$token/clash.yaml;
        limit_except GET { deny all; }
        types { }
        default_type text/plain;
        charset utf-8;
        add_header Content-Disposition inline;
        add_header Cache-Control "private, no-store" always;
        add_header X-Content-Type-Options nosniff always;
    }

@@LEGACY_ROUTES@@
    location = /_clash_request {
        internal;
        proxy_method GET;
        proxy_pass_request_body off;
        proxy_pass_request_headers off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Usage-Token $usage_token;
        proxy_set_header X-Usage-Folder $usage_folder;
        proxy_set_header X-Usage-Method $usage_method;
        proxy_set_header X-Usage-Time $msec;
        proxy_set_header X-Usage-Agent $http_user_agent;
        proxy_connect_timeout 1s;
        proxy_read_timeout 15s;
        proxy_pass http://unix:@@RUNTIME_DIR@@/panel.sock:/internal/track;
    }

    location = /panel { return 308 /panel/; }

    location ^~ /panel/ {
        auth_basic "Clash subscription admin";
        auth_basic_user_file @@AUTH_FILE@@;
        client_max_body_size 2m;
        proxy_set_header Authorization "";
        proxy_pass http://unix:@@RUNTIME_DIR@@/panel.sock;
    }

    location / { return 404; }
}
